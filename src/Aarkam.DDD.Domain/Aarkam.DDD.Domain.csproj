<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Multi Target -->
		<TargetFrameworks>netstandard2.1;net6.0;net8.0;net10.0</TargetFrameworks>

		<!-- Language -->
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Packaging Metadata -->
		<IsPackable>true</IsPackable>
		<PackageId>Aarkam.DDD.Domain</PackageId>
		<Title>Aarkam.DDD.Domain</Title>
		<Version>1.0.4</Version>
		<Authors>Eng. Mohamed ElHelbawi, Aarkam Team</Authors>
		<Company>Aarkam</Company>
		<Description>A high-performance, enterprise-grade, lightweight foundation package for Domain-Driven Design (DDD) and Event Sourcing (ES) patterns in modern .NET ecosystems. Provides pristine core abstractions including Entity, AggregateRoot, ValueObject, Domain Events, Smart Enums (Enumeration), Specifications, Sagas, Projections, Auditing, Multi-Tenancy, and Structured Domain Exceptions with machine-readable ErrorCode, Severity categorization, and contextual Details.</Description>
		<PackageTags>ddd;domain-driven-design;event-sourcing;aggregate-root;value-object;domain-events;smart-enum;enumeration;specifications;saga;projection;cqrs;clean-architecture;structured-errors;error-handling;severity;error-code;auditing;multi-tenancy;aarkam</PackageTags>
		<PackageOutputPath>C:\Nuget</PackageOutputPath>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591;IL2026</NoWarn>
		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>

		<!-- Project and Repository URLs -->
		<PackageProjectUrl>https://aarkam.io/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/melhelbawi/Aarkam.DDD.Domain</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<!-- Source Link & Debugging Symbols -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- License and Readme for NuGet -->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Copyright>Copyright © 2026 Aarkam (https://aarkam.io/) &amp; Mohamed Elhelbawi (https://github.com/melhelbawi). All rights reserved.</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- net6.0 specific: Polyfill for FrozenDictionary (not available natively) -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
		<PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
	</ItemGroup>

	<!-- net8.0 and net10.0 use native FrozenDictionary (best performance) -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
		<PackageReference Include="System.Collections.Immutable" Version="10.0.9" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1' or '$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
	</ItemGroup>

</Project>
